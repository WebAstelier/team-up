# Modèle de configuration locale. Copier vers .env (ignoré par git) et remplir.
# Toutes les valeurs ci-dessous sont fictives. Ne jamais commiter .env.

# Environnement : development | production
NODE_ENV=development

# Port de l'API (sert aussi le front compilé)
PORT=3000

# Chemin du fichier SQLite. Dossier local en développement.
DATABASE_PATH=./data/team-up.sqlite

# Secret de signature des cookies de session (32 caractères minimum, généré localement)
SESSION_SECRET=change-me-generate-locally

# Durées de purge (unité indiquée par le suffixe : heures ou jours)
PURGE_AFTER_START_HOURS=48
PURGE_UNSTARTED_DAYS=30

# Origine publique de l'app (utilisée pour les liens et les QR)
PUBLIC_ORIGIN=http://localhost:3000
