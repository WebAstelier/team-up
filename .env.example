# Local configuration template. Copy to .env (ignored by git) and fill in.
# All values below are placeholders. Never commit .env.

# Environment: development | production
NODE_ENV=development

# API port (also serves the compiled front end)
PORT=3000

# SQLite file path. Local folder in development.
DATABASE_PATH=./data/team-up.sqlite

# Session cookie signing secret (at least 32 characters, generated locally)
SESSION_SECRET=change-me-generate-locally

# Purge delays (unit given by the suffix: hours or days)
PURGE_AFTER_START_HOURS=48
PURGE_UNSTARTED_DAYS=30

# Public origin of the app (used for links and QR codes)
PUBLIC_ORIGIN=http://localhost:3000
