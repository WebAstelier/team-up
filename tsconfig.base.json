{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023"],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "importHelpers": false,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "paths": {
      "@team-up/api/http": ["./libs/api/http/src/index.ts"],
      "@team-up/api/http/testing": ["./libs/api/http/src/testing/index.ts"],
      "@team-up/api/db": ["./libs/api/db/src/index.ts"],
      "@team-up/api/db/testing": ["./libs/api/db/src/testing/index.ts"]
    },
    "resolveJsonModule": true
  },
  "exclude": ["node_modules", "dist", "tmp"]
}
