{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/package-lock.json"],
    "production": ["default", "!{projectRoot}/**/*.spec.ts", "!{projectRoot}/src/testing/**/*"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p {projectRoot}/tsconfig.json"
      },
      "inputs": ["default", "^production"],
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint {projectRoot}"
      },
      "inputs": ["default", "{workspaceRoot}/.oxlintrc.json"],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config $NX_WORKSPACE_ROOT/vitest.config.ts --root {projectRoot}"
      },
      "inputs": ["default", "^production", "{workspaceRoot}/vitest.config.ts"],
      "outputs": ["{workspaceRoot}/coverage/{projectName}"],
      "cache": true
    }
  }
}
