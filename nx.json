{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/package-lock.json"],
    "production": ["default", "!{projectRoot}/**/*.spec.ts", "!{projectRoot}/src/testing/**/*"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "typecheck": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["oxlint {projectRoot}", "eslint {projectRoot}"],
        "parallel": false
      },
      "inputs": ["default", "{workspaceRoot}/.oxlintrc.json", "{workspaceRoot}/eslint.config.mjs"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^production"],
      "cache": true
    }
  }
}
